# Copiar a .env y ajustar. Este fichero NO contiene secretos (van en ./secretos/).

DB_NAME=tienda
DB_USER=tienda
WP_TABLE_PREFIX=tnd_
WP_PUERTO=8080

# URL pública de la tienda (en producción, https://tu-dominio).
WP_URL=http://localhost:8080
WP_TITULO=Tienda
WP_ADMIN_USUARIO=gestor-tienda
WP_ADMIN_EMAIL=soporte@example.com

# production | staging | local
WP_ENVIRONMENT_TYPE=local
# En producción (con HTTPS): true
WP_FORZAR_SSL=false
# true = no se pueden instalar/actualizar plugins desde el panel (actualizar con wp-cli)
WP_BLOQUEAR_INSTALACIONES=false
# Solo si hay un proxy/Cloudflare delante: sus IP o rangos CIDR separados por comas (vacío = sin proxy)
IDITAL_PROXY_CONFIANZA=

# sandbox | produccion   (mientras no ponga "produccion", NO se cobra dinero real)
IDITAL_QONTO_ENTORNO=sandbox
IDITAL_TROPIPAY_ENTORNO=sandbox
